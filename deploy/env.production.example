# Production env template — copy to `.env` NEXT TO docker-compose.prod.yml on the host.
# chmod 600 .env — the real file holds secrets and never enters git.

# --- Deploy identity ---
# Image tag to run. Use the sha-<commit> tag from CI; rollback = previous sha tag.
MPC_IMAGE_TAG=sha-CHANGEME
# MPC_IMAGE_SERVER=ghcr.io/leandrotcawork/marketplace-central-server
# MPC_IMAGE_WEB=ghcr.io/leandrotcawork/marketplace-central-web

# Public domain served by Caddy (TLS is automatic via Let's Encrypt).
MPC_DOMAIN=app.example.com.br

# --- Postgres ---
POSTGRES_PASSWORD=CHANGEME_strong_random

# --- ERP source (oracle | xlsx) ---
MC_ERP_SOURCE=oracle

# --- Sankhya Oracle (reachable via Tailscale subnet router) ---
SANKHYA_ORACLE_HOST=
SANKHYA_ORACLE_PORT=1521
SANKHYA_ORACLE_SERVICE_NAME=
SANKHYA_ORACLE_USER=
SANKHYA_ORACLE_PASSWORD=

# --- Mercado Livre OAuth ---
# Registered callback: https://<MPC_DOMAIN>/integrations/auth/callback
MPC_OAUTH_REDIRECT_URI=https://app.example.com.br/integrations/auth/callback
MPC_PROVIDER_MERCADOLIVRE_CLIENT_ID=
MPC_PROVIDER_MERCADOLIVRE_CLIENT_SECRET=

# --- Credential encryption at rest ---
# MUST be exactly 32 bytes. Generate: openssl rand -hex 16
MPC_ENCRYPTION_KEY=CHANGEME_exactly_32_bytes_please
