{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace-central.local/governance/modules.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "modules", "temporary_exceptions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_id": { "const": "modules" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "root",
          "code_owner_path",
          "composition_required",
          "openapi_prefixes",
          "dependencies"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "kind": {
            "type": "string",
            "enum": ["module", "context"],
            "description": "Absent means module. Registry entries describe current-state structure for governance measurement; they do not select the D1 target boundary. Uniqueness is on the pair (kind, id) while multiple generations coexist."
          },
          "root": { "$ref": "#/$defs/path" },
          "code_owner_path": { "$ref": "#/$defs/path" },
          "composition_required": { "type": "boolean" },
          "openapi_prefixes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^/[a-z0-9][a-z0-9/-]*$" }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        }
      }
    },
    "temporary_exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule_id",
          "source_module",
          "target_module",
          "target_layer",
          "path",
          "import_path",
          "reason",
          "re_adjudicate_in"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "rule_id": { "$ref": "#/$defs/id" },
          "source_module": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "target_module": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "target_layer": { "enum": ["adapters", "transport", "registry"] },
          "path": { "$ref": "#/$defs/path" },
          "import_path": {
            "type": "string",
            "pattern": "^marketplace-central/apps/server_core/internal/modules/[a-z0-9_/-]+$"
          },
          "reason": { "type": "string", "minLength": 1 },
          "re_adjudicate_in": { "$ref": "#/$defs/design_stage" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "design_stage": { "enum": ["D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9"] },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
  }
}
