{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace-central.local/governance/invariants.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "invariants", "temporary_exceptions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_id": { "const": "invariants" },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "scope_paths", "reason_code", "exception_mode"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "check": {
            "enum": [
              "module-coverage",
              "module-dependency",
              "module-target-layer",
              "composition-import",
              "application-import",
              "postgres-driver",
              "api-sdk-atomicity",
              "frontend-fetch",
              "migration-prefix"
            ]
          },
          "scope_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/path" }
          },
          "reason_code": { "type": "string", "pattern": "^GOV_[A-Z0-9_]+$" },
          "exception_mode": {
            "enum": ["none", "exact-path", "exact-edge", "exact-path-set", "exact-occurrence"]
          }
        }
      }
    },
    "temporary_exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule_id", "paths", "occurrences", "reason", "re_adjudicate_in"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "rule_id": { "$ref": "#/$defs/id" },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/path" }
          },
          "occurrences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "symbol", "fingerprint", "count"],
              "properties": {
                "path": { "$ref": "#/$defs/path" },
                "symbol": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]*$" },
                "fingerprint": { "type": "string", "minLength": 1 },
                "count": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "reason": { "type": "string", "minLength": 1 },
          "re_adjudicate_in": { "$ref": "#/$defs/design_stage" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "design_stage": { "enum": ["D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9"] },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
  }
}
