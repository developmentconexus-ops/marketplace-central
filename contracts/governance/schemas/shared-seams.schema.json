{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace-central.local/governance/shared-seams.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "seams"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_id": { "const": "shared-seams" },
    "seams": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "exclusive_paths"],
        "properties": {
          "id": { "enum": ["api-sdk", "migration-sequence", "composition-root", "dependency-graph", "architecture-decisions", "provider-capability-contract", "harness-control"] },
          "exclusive_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[])[A-Za-z0-9._/-]+$" }
  }
}
