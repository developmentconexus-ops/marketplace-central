{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marketplace-central.local/governance/harness-outcome.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "candidate_sha", "branch", "dirty", "acceptance_link", "tools", "commands", "postgres_image_identity", "aggregate_classification"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "dirty": {"type": "boolean"},
    "acceptance_link": {"type": "string", "pattern": "^(unaccepted|F-[0-9]{2}@[0-9a-f]{40})$"},
    "tools": {"type": "object", "additionalProperties": {"type": "string"}},
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "command", "stage", "target_label", "evidence_class", "duration_ms", "exit_code", "reason", "artifact_paths"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "command": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "enum": ["preflight", "provisioning", "validation", "cleanup"]},
          "target_label": {"type": "string", "enum": ["fake", "external-dependency-registry", "ephemeral-postgres", "dev-invariance", "live-oracle", "live-provider", "browser", "provider-write", "cold-gate"]},
          "evidence_class": {"type": "string", "enum": ["contract", "provisioning", "integration", "live", "production-like"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "exit_code": {"type": "integer", "minimum": -1, "maximum": 255},
          "reason": {"type": "string"},
          "artifact_paths": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}}
        }
      }
    },
    "postgres_image_identity": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
    "aggregate_classification": {"type": "string", "enum": ["passed", "failed", "blocked"]}
  }
}
