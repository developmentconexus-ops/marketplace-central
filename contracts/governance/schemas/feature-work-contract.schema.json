{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace-central.local/governance/feature-work-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "required_sources", "allowed_paths", "forbidden_paths", "side_effects", "commands", "criteria", "stop_conditions", "retry_budget", "handoff_fields"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "feature_id": { "type": "string", "pattern": "^F-[0-9]{2}$" },
    "required_sources": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/exactPath" } },
    "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/scopedPath" } },
    "forbidden_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/scopedPath" } },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": { "type": "array", "uniqueItems": true, "items": { "enum": ["none", "repository-write", "database-write", "provider-read", "provider-write", "browser", "isolated-cache-write"] } },
        "forbidden": { "type": "array", "uniqueItems": true, "items": { "enum": ["database-mutation", "external-network", "provider-write"] } }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command_template", "lane_id", "expected_exit_code"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "command_template": { "type": "string", "minLength": 1 },
          "lane_id": { "enum": ["unit", "cold-provision", "integration", "dev-invariance", "live-oracle", "live-provider-read", "browser", "provider-write"] },
          "expected_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "milestone_criterion_id", "command_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{2}-AC[0-9]{2}$" },
          "milestone_criterion_id": { "type": "string", "pattern": "^M-[0-9]{2}-C[0-9]{2}$" },
          "command_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "condition"],
        "properties": { "code": { "$ref": "#/$defs/id" }, "condition": { "type": "string", "minLength": 1 } }
      }
    },
    "retry_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_correction_attempts"],
      "properties": { "max_correction_attempts": { "type": "integer", "minimum": 0, "maximum": 3 } }
    },
    "handoff_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "exactPath": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[])[A-Za-z0-9._/-]+$" },
    "scopedPath": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?\\[])[A-Za-z0-9._/-]+(?:/\\*\\*)?$" }
  }
}
