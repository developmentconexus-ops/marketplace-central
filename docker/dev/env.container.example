# Copy these keys into your local .env or export them in your shell.
# Do not commit real tokens or provider secrets.

# Required only when running the oauth profile.
NGROK_AUTHTOKEN=

# This repo's current Mercado Livre app is already registered with this callback URL.
# The ngrok container derives its reserved domain from this value.
MPC_OAUTH_REDIRECT_URI=https://multiradial-unironically-nieves.ngrok-free.dev/integrations/auth/callback

# Compose overrides MC_DATABASE_URL for the backend container so it can reach
# the postgres service. Keep local MC_DATABASE_URL in .env for host-based runs.
