  73: /**
  74:  * Provider display name for a wire `provider_code`. The wire value is a slug
  75:  * ("mercado_livre"); rendering it raw is the bug that hit CHIP-PED-FILA across
  76:  * four surfaces.
  77:  *
  78:  * An unmapped provider is TYPESET rather than passed through — `mercado_livre`
  79:  * is the only mapped code today, so the next marketplace onboarded would
  80:  * otherwise put a raw slug back on screen — but only when the typeset form
  81:  * ROUND-TRIPS back to the exact wire code.
  82:  *
  83:  * That condition is the whole design, and it exists because the obvious version
  84:  * of this function is wrong. Collapsing every separator into a space maps
  85:  * `amazon_marketplace` and `amazon-marketplace` onto the same "Amazon
  86:  * Marketplace", and `registry.go:100-114` dedupes provider codes by exact
  87:  * string equality, so both are legal, distinct, simultaneously-registered
  88:  * providers. Two different marketplaces would render identically and the
  89:  * operator could not tell whose listing they were looking at. A slug that is
  90:  * merely ugly is a cosmetic problem; two providers wearing one name is wrong
  91:  * information, which is worse.
  92:  *
  93:  * So the transform is applied only where it is INJECTIVE: lower-case
  94:  * underscore slugs, where `"amazon_marketplace" → "Amazon Marketplace" →
  95:  * "amazon_marketplace"` returns the input unchanged. Anything else — hyphens,
  96:  * mixed case, embedded spaces, anything that would lose a character — renders
  97:  * verbatim, because an ugly identifier the operator can act on beats a pretty
  98:  * name that might be the wrong provider.
  99:  */
 100: const providerDisplayNames: Record<string, string> = {
 101:   mercado_livre: "Mercado Livre",
 102: };
 103: 
 104: function typesetSlug(providerCode: string): string {
 105:   return providerCode
 106:     .split("_")
 107:     .map((word) => (word.length > 0 ? word.charAt(0).toUpperCase() + word.slice(1) : word))
 108:     .join(" ");
 109: }
 110: 
 111: export function providerDisplayName(providerCode: string): string {
 112:   const mapped = providerDisplayNames[providerCode];
 113:   if (mapped) return mapped;
 114: 
 115:   const typeset = typesetSlug(providerCode);
 116:   // The round-trip IS the injectivity check: if lowering the typeset form and
 117:   // restoring the separators does not reproduce the wire code byte for byte,
 118:   // then some other code could typeset to the same string, and the display
 119:   // would be ambiguous. Ambiguous loses to verbatim.
 120:   const restored = typeset.toLowerCase().split(" ").join("_");
 121:   return restored === providerCode ? typeset : providerCode;
 122: }
