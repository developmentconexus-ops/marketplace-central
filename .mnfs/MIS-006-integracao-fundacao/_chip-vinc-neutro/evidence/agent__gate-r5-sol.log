 192: // `side` is the second half of D-122/D-B: WHICH side is missing the value, and
 193: // therefore where the operator has to go fix it. Read from the field, never
 194: // parsed out of `detail` — parsing a Portuguese sentence breaks silently the day
 195: // someone rewrites the sentence, which is exactly why D-B put it in the data.
 196: const incomparableSideLabels: Record<ProductLinkReasonSide, string> = {
 197:   provider: "falta no anúncio",
 198:   erp: "falta no ERP",
 199:   both: "falta nos dois lados",
 200: };
