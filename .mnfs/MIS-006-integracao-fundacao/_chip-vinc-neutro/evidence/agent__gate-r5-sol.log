 571: // applyConflictScore scores the CODPROD≠EAN conflict. Neither anchor wins
 572: // (AC-08, ratified by the operator): both products are offered for review with
 573: // the disagreement spelled out, and the decision is the operator's.
 574: func applyConflictScore(candidate *domain.LinkCandidate, ownAnchor, conflictAnchor string, ownProductID int, conflictingIDs []int, comparison providerIdentityAnchorComparison) {
 575: 	candidate.Confidence = 20
 576: 	candidate.ConfidenceBand = domain.LinkCandidateConfidenceBandBaixa
 577: 	candidate.MatchStatus = domain.LinkCandidateMatchStatusReview
 578: 	reasons := []domain.LinkCandidateReason{
 579: 		{Anchor: ownAnchor, Direction: domain.LinkCandidateReasonDirectionFor, Detail: fmt.Sprintf("%s aponta codprod %d", ownAnchor, ownProductID)},
 580: 		{Anchor: conflictAnchor, Direction: domain.LinkCandidateReasonDirectionAgainst, Detail: fmt.Sprintf("%s aponta codprod %s (conflito, nenhuma âncora vence)", conflictAnchor, formatProductIDs(conflictingIDs))},
 581: 	}
 582: 	candidate.Reasons = appendProviderDeclaredUnavailableReasons(reasons, comparison)
 583: }
