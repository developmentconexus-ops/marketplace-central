 179: function pill(label: string, className: string) {
 180:   return (
 181:     <span className={`inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ${className}`}>
 182:       {label}
 183:     </span>
 184:   );
 185: }
