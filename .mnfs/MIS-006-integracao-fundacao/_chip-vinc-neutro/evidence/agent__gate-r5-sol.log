 470: 
 471: // --- IC-01 Amendment A2 scoring (confidence/band/status/reasons) ---
 472: //
 473: // seller_sku and ean are the only cross-side anchors available against
 474: // provider data (A2); title ranks only, never accepts. Hard-negative title
 475: // lexical checks (kit/combo/cor/voltagem) cap
 476: // any match at BAIXA/REJECT even when EAN/SKU agree ("contradição vence
 477: // EAN").
 478: 
 479: type providerIdentityAnchorComparison struct {
 480: 	declared []ports.ProviderIdentityAnchor
 481: 	listing  domain.ListingSnapshot
 482: 	product  *internalreaddomain.ProductCandidate
 483: }
 484: 
 485: func newProviderIdentityAnchorComparison(snapshot domain.ListingSnapshot, declared []ports.ProviderIdentityAnchor, product *internalreaddomain.ProductCandidate) providerIdentityAnchorComparison {
 486: 	return providerIdentityAnchorComparison{declared: declared, listing: snapshot, product: product}
 487: }
 488: 
 489: func buildConcordantCandidate(snapshot domain.ListingSnapshot, skuMatches, eanMatches productMatchResult, comparison providerIdentityAnchorComparison, now time.Time) domain.LinkCandidate {
 490: 	product := *comparison.product
 491: 	candidate := newCandidate(snapshot, domain.LinkCandidateStateExactSKU, domain.LinkCandidateMatchInputSellerSKU, skuMatches.InputValue, product, now)
 492: 
 493: 	reasons := []domain.LinkCandidateReason{
 494: 		{Anchor: "seller_sku", Direction: domain.LinkCandidateReasonDirectionFor, Detail: "seller_sku resolve exato para codprod"},
 495: 		{Anchor: "ean", Direction: domain.LinkCandidateReasonDirectionFor, Detail: "ean corrobora o mesmo codprod (unproved)"},
 496: 	}
 497: 	if hardNeg, detail := detectHardNegative(snapshot.Title, product.Name); hardNeg {
 498: 		candidate.Confidence = 25
 499: 		candidate.ConfidenceBand = domain.LinkCandidateConfidenceBandBaixa
 500: 		candidate.MatchStatus = domain.LinkCandidateMatchStatusReject
 501: 		reasons = append(reasons, domain.LinkCandidateReason{Anchor: "title", Direction: domain.LinkCandidateReasonDirectionAgainst, Detail: detail})
 502: 	} else {
 503: 		candidate.Confidence = 95
 504: 		candidate.ConfidenceBand = domain.LinkCandidateConfidenceBandAlta
 505: 		candidate.MatchStatus = domain.LinkCandidateMatchStatusAccept
 506: 	}
 507: 	candidate.Reasons = appendProviderDeclaredUnavailableReasons(reasons, comparison)
 508: 	return candidate
 509: }
 510: 
 511: func applySingleAnchorScore(candidate *domain.LinkCandidate, state domain.LinkCandidateState, comparison providerIdentityAnchorComparison) {
 512: 	snapshot := comparison.listing
 513: 	product := internalreaddomain.ProductCandidate{}
 514: 	if comparison.product != nil {
 515: 		product = *comparison.product
 516: 	}
 517: 	var reasons []domain.LinkCandidateReason
 518: 	var confidence int
 519: 	var band domain.LinkCandidateConfidenceBand
 520: 	var status domain.LinkCandidateMatchStatus
 521: 
 522: 	switch state {
 523: 	case domain.LinkCandidateStateExactSKU:
 524: 		// D-121-2: one anchor resolved one product and nothing contradicts it,
 525: 		// but nothing corroborates it either — that is the confirmation queue,
 526: 		// not an automatic link and not a review. The warning names the anchor
 527: 		// that is missing, so the operator knows what they are supplying by
 528: 		// confirming.
 529: 		confidence, band, status = 70, domain.LinkCandidateConfidenceBandMedia, domain.LinkCandidateMatchStatusConfirm
 530: 		eanDetail := "sem EAN para corroborar o CODPROD"
 531: 		if strings.TrimSpace(snapshot.EAN) != "" {
 532: 			eanDetail = "sem EAN para corroborar o CODPROD: o EAN do anúncio não casa nenhum produto"
 533: 		}
 534: 		reasons = []domain.LinkCandidateReason{
 535: 			{Anchor: "seller_sku", Direction: domain.LinkCandidateReasonDirectionFor, Detail: "seller_sku resolve exato para codprod"},
 536: 			missingMatchedAnchorReason("ean", eanDetail, snapshot, &product),
 537: 		}
 538: 	case domain.LinkCandidateStateExactEAN:
 539: 		confidence, band, status = 60, domain.LinkCandidateConfidenceBandMedia, domain.LinkCandidateMatchStatusConfirm
 540: 		skuDetail := "sem CODPROD para corroborar o EAN"
 541: 		if strings.TrimSpace(snapshot.SellerSKU) != "" {
 542: 			skuDetail = "sem CODPROD para corroborar o EAN: o seller_sku do anúncio não casa nenhum produto"
 543: 		}
 544: 		reasons = []domain.LinkCandidateReason{
 545: 			{Anchor: "ean", Direction: domain.LinkCandidateReasonDirectionFor, Detail: "ean corrobora codprod (unproved)"},
 546: 			missingMatchedAnchorReason("seller_sku", skuDetail, snapshot, &product),
 547: 		}
 548: 	case domain.LinkCandidateStateTitleMatch:
 549: 		confidence, band, status = 35, domain.LinkCandidateConfidenceBandBaixa, domain.LinkCandidateMatchStatusReview
 550: 		reasons = []domain.LinkCandidateReason{
 551: 			{Anchor: "title", Direction: domain.LinkCandidateReasonDirectionFor, Detail: "match por título (ranking-only, nunca ACCEPT)"},
 552: 			missingMatchedAnchorReason("seller_sku", "seller_sku sem correspondência", snapshot, &product),
 553: 			missingMatchedAnchorReason("ean", "ean sem correspondência", snapshot, &product),
 554: 		}
 555: 	default:
 556: 		applyUnresolvedScore(candidate, comparison)
 557: 		return
 558: 	}
 559: 
 560: 	if hardNeg, detail := detectHardNegative(snapshot.Title, product.Name); hardNeg {
 561: 		confidence, band, status = 25, domain.LinkCandidateConfidenceBandBaixa, domain.LinkCandidateMatchStatusReject
 562: 		reasons = append(reasons, domain.LinkCandidateReason{Anchor: "title", Direction: domain.LinkCandidateReasonDirectionAgainst, Detail: detail})
 563: 	}
 564: 
 565: 	candidate.Confidence = confidence
 566: 	candidate.ConfidenceBand = band
 567: 	candidate.MatchStatus = status
 568: 	candidate.Reasons = appendProviderDeclaredUnavailableReasons(reasons, comparison)
 569: }
