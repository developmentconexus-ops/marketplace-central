  57: }
  58: 
  59: // INCOMPARABLE gets its OWN token pair (info), never accent (FOR — corroborates)
  60: // and never warn (AGAINST — blocks) and never the muted surface of UNAVAILABLE.
  61: // D-122/D-B created the state precisely to separate "the provider does not
  62: // supply this anchor, ever" (UNAVAILABLE, nothing to do) from "the provider does
  63: // supply it and the value is missing HERE" (INCOMPARABLE, go register it):
  64: // opposite operator actions, so painting them alike would erase the distinction
  65: // the state exists to show.
  66: export const directionClasses: Record<ProductLinkReasonDirection, string> = {
  67:   FOR: "bg-accent-soft text-accent-ink",
  68:   AGAINST: "bg-warn-soft text-warn",
  69:   UNAVAILABLE: "bg-surface-2 text-faint",
  70:   INCOMPARABLE: "bg-info-soft text-info",
  71: };
  72: 
  73: /**
  74:  * Provider display name for a wire `provider_code`. The wire value is a slug
  75:  * ("mercado_livre"); rendering it raw is the bug that hit CHIP-PED-FILA across
  76:  * four surfaces.
  77:  *
  78:  * An unmapped provider is TYPESET rather than passed through — `mercado_livre`
  79:  * is the only mapped code today, so the next marketplace onboarded would
  80:  * otherwise put a raw slug back on screen — but only when the typeset form
  81:  * ROUND-TRIPS back to the exact wire code.
  82:  *
  83:  * That condition is the whole design, and it exists because the obvious version
  84:  * of this function is wrong. Collapsing every separator into a space maps
  85:  * `amazon_marketplace` and `amazon-marketplace` onto the same "Amazon
  86:  * Marketplace", and `registry.go:100-114` dedupes provider codes by exact
  87:  * string equality, so both are legal, distinct, simultaneously-registered
  88:  * providers. Two different marketplaces would render identically and the
  89:  * operator could not tell whose listing they were looking at. A slug that is
  90:  * merely ugly is a cosmetic problem; two providers wearing one name is wrong
  91:  * information, which is worse.
  92:  *
  93:  * So the transform is applied only where it is INJECTIVE: lower-case
  94:  * underscore slugs, where `"amazon_marketplace" → "Amazon Marketplace" →
  95:  * "amazon_marketplace"` returns the input unchanged. Anything else — hyphens,
  96:  * mixed case, embedded spaces, anything that would lose a character — renders
  97:  * verbatim, because an ugly identifier the operator can act on beats a pretty
  98:  * name that might be the wrong provider.
  99:  */
 100: const providerDisplayNames: Record<string, string> = {
 101:   mercado_livre: "Mercado Livre",
 102: };
 103: 
 104: function typesetSlug(providerCode: string): string {
 105:   return providerCode
 106:     .split("_")
 107:     .map((word) => (word.length > 0 ? word.charAt(0).toUpperCase() + word.slice(1) : word))
 108:     .join(" ");
 109: }
 110: 
 111: export function providerDisplayName(providerCode: string): string {
 112:   const mapped = providerDisplayNames[providerCode];
 113:   if (mapped) return mapped;
 114: 
 115:   const typeset = typesetSlug(providerCode);
 116:   // The round-trip IS the injectivity check: if lowering the typeset form and
 117:   // restoring the separators does not reproduce the wire code byte for byte,
 118:   // then some other code could typeset to the same string, and the display
 119:   // would be ambiguous. Ambiguous loses to verbatim.
 120:   const restored = typeset.toLowerCase().split(" ").join("_");
 121:   return restored === providerCode ? typeset : providerCode;
 122: }
 123: 
 124: /**
 125:  * "Identificado por" (D-122): the anchors that DECIDED, joined by ` + `.
 126:  *
 127:  * This is not a new rule invented on the screen. `decisionRuleForCandidate`
 128:  * (resolution_service.go:812-835) is a PURE function of `match_status` and
 129:  * `match_input` — both already on the wire — and it is the same function that
 130:  * writes `rule_matched` into the decision trail. Reading the same two inputs
 131:  * lands on the same rule, so the column says what the trail will say.
 132:  *
 133:  * Anything that is not an ACCEPT or a single-anchor CONFIRM files as `manual`:
 134:  * no anchor carried it, so the column names none. That is what separates this
 135:  * column from Motivo — Motivo lists everything that OPINED (including every
 136:  * UNAVAILABLE and INCOMPARABLE), this lists only what DECIDED. A `title FOR`
 137:  * candidate (state TitleMatch → REVIEW, ranking-only and never ACCEPT under
 138:  * D-121) therefore keeps its motivo and shows NOTHING here.
 139:  *
 140:  * Both maps are keyed by the full union rather than switched on string
 141:  * literals: a sixth match_status or a new match_input has to fail the compiler,
 142:  * not fall silently through a `default` — the QueueRow:159 lesson.
 143:  */
 144: const confirmDecidingAnchors: Record<ProductLinkCandidateMatchInput, string[]> = {
 145:   seller_sku: ["CODPROD"],
 146:   ean: ["EAN"],
 147:   title: [],
 148:   manual: [],
 149:   none: [],
 150: };
 151: 
 152: const statusDecidingAnchors: Record<
 153:   ProductLinkMatchStatus,
 154:   (matchInput: ProductLinkCandidateMatchInput) => string[]
 155: > = {
 156:   // Corroborated: CODPROD and EAN both named this product. Hiding the second
 157:   // anchor would erase from the screen the very thing that separates
 158:   // auto-approved from sent-to-confirmation (D-121).
 159:   ACCEPT: () => ["CODPROD", "EAN"],
 160:   CONFIRM: (matchInput) => confirmDecidingAnchors[matchInput],
 161:   // The anchors disagreed, collided, or never ran. Nothing decided.
 162:   REVIEW: () => [],
 163:   REJECT: () => [],
 164:   NO_CANDIDATE: () => [],
 165: };
 166: 
 167: export function decidingAnchors(candidate: ProductLinkCandidateItem): string[] {
 168:   // The `Record<Union, …>` above is the COMPILE-time guard: a sixth status in
 169:   // the SDK breaks the build here, which is the whole point. This runtime guard
 170:   // answers a different failure — the wire shipping a status the SDK does not
 171:   // have yet, where the map lookup is `undefined` and calling it takes down the
 172:   // entire queue table instead of one cell. An unknown status means we do not
 173:   // know what decided, so the column renders the honest unknown (ADR-17).
 174:   const rule = statusDecidingAnchors[candidate.match_status];
 175:   if (!rule) return [];
 176:   return rule(candidate.match_input) ?? [];
 177: }
