 100: func buildDefinitions(entries []domain.ProviderDefinition) ([]domain.ProviderDefinition, error) {
 101: 	out := make([]domain.ProviderDefinition, 0, len(entries))
 102: 	seenCodes := make(map[string]struct{}, len(entries))
 103: 	for _, entry := range entries {
 104: 		code := strings.TrimSpace(entry.ProviderCode)
 105: 		if code == "" {
 106: 			return nil, errors.New("INTEGRATIONS_PROVIDER_CODE_REQUIRED")
 107: 		}
 108: 		if _, exists := seenCodes[code]; exists {
 109: 			return nil, fmt.Errorf("INTEGRATIONS_PROVIDER_DUPLICATE: provider_code=%s", code)
 110: 		}
 111: 		seenCodes[code] = struct{}{}
 112: 		out = append(out, cloneProviderDefinition(entry))
 113: 	}
 114: 	return out, nil
 115: }
