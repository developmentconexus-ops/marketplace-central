 612: // applyUnresolvedScore scores a listing no anchor could resolve. What M05-C5
 613: // asks for is the REASON: the operator has to see WHY the matcher had nothing
 614: // to offer, never a silent empty row. The status stays NO_CANDIDATE because
 615: // /vinculos keys the ADR-17 affordance off it — the "sem candidato / Criar
 616: // produto / Ignorar" row, and the batch-select guard that stops an operator
 617: // from bulk-approving a listing with no product to approve. Reclassifying it
 618: // as REVIEW would have made those branches dead code on a screen this
 619: // milestone may not edit (apps/web is M-06's seam). Flagged to the hub.
 620: func applyUnresolvedScore(candidate *domain.LinkCandidate, comparison providerIdentityAnchorComparison) {
 621: 	candidate.Confidence = 0
 622: 	candidate.ConfidenceBand = domain.LinkCandidateConfidenceBandBaixa
 623: 	candidate.MatchStatus = domain.LinkCandidateMatchStatusNoCandidate
 624: 	reasons := []domain.LinkCandidateReason{
 625: 		missingMatchedAnchorReason("seller_sku", "seller_sku sem correspondência", comparison.listing, nil),
 626: 		missingMatchedAnchorReason("ean", "ean sem correspondência", comparison.listing, nil),
 627: 	}
 628: 	candidate.Reasons = appendProviderDeclaredUnavailableReasons(reasons, comparison)
 629: }
