 631: func missingMatchedAnchorReason(anchor, detail string, listing domain.ListingSnapshot, product *internalreaddomain.ProductCandidate) domain.LinkCandidateReason {
 632: 	listingValue, productValue, _ := identityAnchorValues(anchor, listing, product)
 633: 	reason := domain.LinkCandidateReason{Anchor: anchor, Detail: detail}
 634: 	switch {
 635: 	case listingValue == "":
 636: 		reason.Direction = domain.LinkCandidateReasonDirectionIncomparable
 637: 		reason.Side = domain.LinkCandidateReasonSideProvider
 638: 	case product == nil || productValue == "":
 639: 		reason.Direction = domain.LinkCandidateReasonDirectionIncomparable
 640: 		reason.Side = domain.LinkCandidateReasonSideERP
 641: 	default:
 642: 		reason.Direction = domain.LinkCandidateReasonDirectionUnavailable
 643: 	}
 644: 	return reason
 645: }
 646: 
 647: func appendProviderDeclaredUnavailableReasons(reasons []domain.LinkCandidateReason, comparison providerIdentityAnchorComparison) []domain.LinkCandidateReason {
 648: 	finalized := make([]domain.LinkCandidateReason, 0, len(reasons)+len(comparison.declared))
 649: 	hasSignal := make(map[string]bool, len(reasons))
 650: 	absenceIndexes := make(map[string]int, len(reasons)+len(comparison.declared))
 651: 	for _, reason := range reasons {
 652: 		if reason.Direction == domain.LinkCandidateReasonDirectionFor ||
 653: 			reason.Direction == domain.LinkCandidateReasonDirectionAgainst {
 654: 			hasSignal[reason.Anchor] = true
 655: 		}
 656: 	}
 657: 	for _, reason := range reasons {
 658: 		if reason.Direction != domain.LinkCandidateReasonDirectionUnavailable &&
 659: 			reason.Direction != domain.LinkCandidateReasonDirectionIncomparable {
 660: 			finalized = append(finalized, reason)
 661: 			continue
 662: 		}
 663: 		if hasSignal[reason.Anchor] {
 664: 			continue
 665: 		}
 666: 		if _, exists := absenceIndexes[reason.Anchor]; !exists {
 667: 			absenceIndexes[reason.Anchor] = len(finalized)
 668: 			finalized = append(finalized, reason)
 669: 		}
 670: 	}
 671: 	for _, anchor := range comparison.declared {
 672: 		if hasSignal[anchor.Anchor] {
 673: 			continue
 674: 		}
 675: 
 676: 		direction, side, detail, emit := classifyProviderIdentityAnchor(anchor, comparison)
 677: 		if !emit {
 678: 			continue
 679: 		}
 680: 
 681: 		reason := domain.LinkCandidateReason{
 682: 			Anchor:    anchor.Anchor,
 683: 			Direction: direction,
 684: 			Side:      side,
 685: 			Detail:    detail,
 686: 		}
 687: 		if index, exists := absenceIndexes[anchor.Anchor]; exists {
 688: 			// A seeded absence sentence contains domain context; promote only its
 689: 			// classification and retain that sentence for the operator.
 690: 			if direction == domain.LinkCandidateReasonDirectionIncomparable {
 691: 				reason.Detail = finalized[index].Detail
 692: 			}
 693: 			finalized[index] = reason
 694: 			continue
 695: 		}
 696: 		absenceIndexes[anchor.Anchor] = len(finalized)
 697: 		finalized = append(finalized, reason)
 698: 	}
 699: 	return finalized
 700: }
