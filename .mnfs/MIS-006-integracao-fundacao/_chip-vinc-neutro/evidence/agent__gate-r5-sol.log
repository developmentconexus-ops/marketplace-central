 585: // applyCollisionScore scores one product out of a set an ambiguous anchor
 586: // matched. The anchor named N products, so it identified none of them.
 587: func applyCollisionScore(candidate *domain.LinkCandidate, anchor string, matchCount int, otherIDs []int, comparison providerIdentityAnchorComparison) {
 588: 	candidate.Confidence = 20
 589: 	candidate.ConfidenceBand = domain.LinkCandidateConfidenceBandBaixa
 590: 	candidate.MatchStatus = domain.LinkCandidateMatchStatusReview
 591: 	reasons := []domain.LinkCandidateReason{
 592: 		{Anchor: anchor, Direction: domain.LinkCandidateReasonDirectionAgainst, Detail: fmt.Sprintf("%s casa %d produtos no ERP (colisão: também codprod %s) ⇒ âncora ambígua", anchor, matchCount, formatProductIDs(otherIDs))},
 593: 	}
 594: 	candidate.Reasons = appendProviderDeclaredUnavailableReasons(reasons, comparison)
 595: }
 596: 
 597: // applyAmbiguousCorroborationScore scores the anchor that DID resolve a single
 598: // product on a listing whose other anchor collided. The single anchor is real,
 599: // but there is nothing to corroborate it against — an ambiguous anchor
 600: // corroborates nothing — so it is review, never confirmation.
 601: func applyAmbiguousCorroborationScore(candidate *domain.LinkCandidate, ownAnchor string, ownProductID int, otherAnchor string, otherCount int, comparison providerIdentityAnchorComparison) {
 602: 	candidate.Confidence = 40
 603: 	candidate.ConfidenceBand = domain.LinkCandidateConfidenceBandBaixa
 604: 	candidate.MatchStatus = domain.LinkCandidateMatchStatusReview
 605: 	reasons := []domain.LinkCandidateReason{
 606: 		{Anchor: ownAnchor, Direction: domain.LinkCandidateReasonDirectionFor, Detail: fmt.Sprintf("%s aponta codprod %d", ownAnchor, ownProductID)},
 607: 		{Anchor: otherAnchor, Direction: domain.LinkCandidateReasonDirectionAgainst, Detail: fmt.Sprintf("%s casa %d produtos no ERP ⇒ não corrobora", otherAnchor, otherCount)},
 608: 	}
 609: 	candidate.Reasons = appendProviderDeclaredUnavailableReasons(reasons, comparison)
 610: }
