 265:  * the total ranking that replaced it keeps every reason, correctly. Undoing a
 266:  * silent filter must not install a literal "undefined" in its place — that
 267:  * would trade one invisible defect for a visible-but-meaningless one.
 268:  *
 269:  * Falling back to a KNOWN direction is not an option: "–" would read as
 270:  * UNAVAILABLE ("nothing to compare, ever") and "?" as INCOMPARABLE ("go
 271:  * register the value"), which are opposite operator actions. The wire word is
 272:  * the only honest thing to show (ADR-17).
 273:  */
 274: export function directionGlyph(direction: ProductLinkReasonDirection): string {
 275:   const glyph = directionGlyphs[direction];
 276:   return glyph ?? direction;
 277: }
 278: 
 279: export function directionClass(direction: ProductLinkReasonDirection): string {
 280:   return directionClasses[direction] ?? unknownValueClasses;
 281: }
 282: 
 283: function anchorShortLabel(anchor: string): string {
 284:   return anchorShortLabels[anchor] ?? anchor;
 285: }
 286: 
 287: /**
 288:  * Compact chip label for the table. FOR/UNAVAILABLE motivos restate the anchor
 289:  * ("seller_sku resolve exato para codprod") so the detail adds nothing at a
 290:  * glance and lives in the tooltip. An AGAINST detail is the *reason the vínculo
 291:  * is blocked* — it stays inline (CSS-truncated to one line, full text in the
 292:  * tooltip and in the expanded view).
 293:  */
 294: function compactChipLabel(reason: ProductLinkReason): string {
 295:   const side = reasonSideLabel(reason);
 296:   // The side rides inline, not only in the tooltip: "where do I go fix it" is
 297:   // the whole point of an INCOMPARABLE, and a tooltip is not readable on a scan.
 298:   const anchor = side ? `${anchorShortLabel(reason.anchor)} (${side})` : anchorShortLabel(reason.anchor);
 299:   const head = `${directionGlyph(reason.direction)} ${anchor}`;
 300:   if (reason.direction === "AGAINST" && reason.detail) {
 301:     return `${head}: ${reason.detail}`;
 302:   }
 303:   return head;
 304: }
 305: 
 306: function compactChip(reason: ProductLinkReason) {
 307:   return (
 308:     <span
 309:       data-testid="motivo-chip"
 310:       data-direction={reason.direction}
 311:       title={reasonChipLabel(reason)}
 312:       className={`inline-flex max-w-[12rem] items-center truncate whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ${directionClass(reason.direction)}`}
 313:     >
 314:       {compactChipLabel(reason)}
 315:     </span>
 316:   );
 317: }
 318: 
 319: const COMPACT_CHIP_LIMIT = 2;
 320: 
 321: // Display priority for the collapsed cell. AGAINST first (a blocking
 322: // contradiction is what the operator must read), then FOR (what corroborates),
 323: // then INCOMPARABLE — actionable absence, the operator CAN go register the
 324: // value — and last UNAVAILABLE, the only permanent one and therefore the only
 325: // one nothing can be done about.
 326: const directionRank: Record<ProductLinkReasonDirection, number> = {
 327:   AGAINST: 0,
 328:   FOR: 1,
 329:   INCOMPARABLE: 2,
 330:   UNAVAILABLE: 3,
 331: };
 332: 
 333: // A direction we cannot interpret ranks after all four we can, so it never
 334: // displaces an actionable signal out of the two compact slots. It is still
 335: // RANKED, not filtered — the whole point of the ordering being total.
 336: const UNKNOWN_DIRECTION_RANK = 4;
 337: 
 338: function directionRankOf(direction: ProductLinkReasonDirection): number {
 339:   const rank = directionRank[direction];
 340:   return rank ?? UNKNOWN_DIRECTION_RANK;
 341: }
 342: 
 343: /**
 344:  * Motivo cell. Collapsed by default to keep the row one line tall (a 4-chip
 345:  * stack of full sentences made every row ~5 lines and pushed the Ação column
 346:  * off-screen). AGAINST motivos are ranked first — a blocking contradiction is
 347:  * what the operator must read — and nothing is silently dropped: the remainder
 348:  * is behind a "+N" toggle that renders every motivo in its full wire form.
 349:  */
 350: function AnchorChips({ reasons }: { reasons: ProductLinkReason[] }) {
 351:   const [expanded, setExpanded] = useState(false);
 352: 
 353:   if (reasons.length === 0) {
 354:     return <UnknownValue hint="sem sinais de correspondência" />;
 355:   }
 356: 
 357:   if (expanded) {
 358:     return (
 359:       <div className="flex flex-col items-start gap-1">
 360:         <ul className="flex flex-col items-start gap-1">
 361:           {reasons.map((reason, index) => (
 362:             <li key={`${reason.anchor}-${index}`}>
 363:               {/* Expandido: o texto integral do motivo pode quebrar linha — o
 364:                   chip nowrap do modo compacto seria cortado pelo limite do td. */}
 365:               <span
 366:                 className={`inline-block rounded-2xl px-2 py-0.5 text-xs font-medium ${directionClass(reason.direction)}`}
 367:               >
 368:                 {reasonChipLabel(reason)}
 369:               </span>
 370:             </li>
 371:           ))}
 372:         </ul>
 373:         <button
 374:           type="button"
 375:           className="rounded-control px-1 text-xs font-medium text-muted underline hover:text-ink"
 376:           onClick={() => setExpanded(false)}
 377:         >
 378:           menos
 379:         </button>
 380:       </div>
 381:     );
 382:   }
 383: 
 384:   // Rank and slice. Ranking (never filtering) is what keeps at least one motivo
 385:   // on screen even for a row whose only signals are absence ones (ADR-17 —
 386:   // motivo sempre visível).
 387:   //
 388:   // This USED to be `[...byDirection("AGAINST"), ...byDirection("FOR"),
 389:   // ...byDirection("UNAVAILABLE")]` — an enumeration by string literal. It is
 390:   // type-correct, so the compiler said nothing when D-B added a fourth
 391:   // direction, and the "ranking" quietly became a FILTER: a row whose motivos
 392:   // are all INCOMPARABLE produced an empty `shown` and rendered a lone "+N"
 393:   // button with zero chips — the exact opposite of the invariant above.
 394:   //
 395:   // A sort over a Record<Direction, number> is total by construction: every
 396:   // reason keeps a place in the ordering, so `shown` is empty only when
 397:   // `reasons` is, and a future fifth direction stops COMPILING here instead of
 398:   // disappearing from the cell.
 399:   const shown = reasons
 400:     .map((reason, index) => ({ reason, index }))
 401:     // The index tiebreak keeps the wire order inside a direction, so the cell
 402:     // does not reshuffle between renders for reasons that rank equally.
 403:     .sort((a, b) => directionRankOf(a.reason.direction) - directionRankOf(b.reason.direction) || a.index - b.index)
 404:     .slice(0, COMPACT_CHIP_LIMIT)
 405:     .map((entry) => entry.reason);
 406:   const hidden = reasons.length - shown.length;
 407: 
 408:   return (
 409:     <div className="flex min-w-0 items-center gap-1">
 410:       <ul className="flex min-w-0 items-center gap-1">
 411:         {shown.map((reason, index) => (
 412:           <li key={`${reason.anchor}-${index}`} className="min-w-0">
 413:             {compactChip(reason)}
 414:           </li>
 415:         ))}
 416:       </ul>
 417:       {hidden > 0 ? (
 418:         <button
 419:           type="button"
 420:           aria-label={`Mostrar todos os ${reasons.length} motivos`}
