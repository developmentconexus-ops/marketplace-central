  16: 
  17: const bandClasses: Record<ProductLinkConfidenceBand, string> = {
  18:   ALTA: "bg-accent-soft text-accent-ink",
  19:   MEDIA: "bg-amber-soft text-amber",
  20:   BAIXA: "bg-warn-soft text-warn",
  21: };
  22: 
  23: // Direction tokens come from QueueRow, the one place that owns them: the drawer
  24: // used to keep a second copy, which is why the third state could be added to one
  25: // map and silently missed here. One `Record<ProductLinkReasonDirection, …>` for
  26: // the screen means a future direction breaks the build once, not zero times.
  27: 
  28: function pill(label: string, className: string) {
  29:   return (
  30:     <span className={`inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ${className}`}>
  31:       {label}
  32:     </span>
  33:   );
  34: }
  35: 
  36: function confidencePercent(confidence: number): string {
  37:   if (!Number.isFinite(confidence)) return "";
  38:   return `${Math.round(confidence)}%`;
  39: }
  40: 
  41: function Fact({ label, children }: { label: string; children: React.ReactNode }) {
  42:   return (
  43:     <div className="flex items-start justify-between gap-4 border-b border-border-2 pb-2 last:border-b-0 last:pb-0">
  44:       <dt className="text-xs text-faint">{label}</dt>
  45:       <dd className="text-right text-xs font-medium text-ink">{children}</dd>
  46:     </div>
  47:   );
  48: }
  49: 
  50: function CandidateCompareCard({
  51:   candidate,
  52:   rank,
  53:   isSelected,
  54:   onApprove,
  55:   pending,
  56: }: {
  57:   candidate: ProductLinkCandidateItem;
  58:   rank: number;
  59:   isSelected: boolean;
  60:   onApprove: (candidate: ProductLinkCandidateItem) => void;
  61:   pending?: boolean;
  62: }) {
  63:   const noCandidate = candidate.match_status === "NO_CANDIDATE";
  64:   return (
  65:     <section
  66:       data-testid="drawer-candidate"
  67:       className={`rounded-card border p-3 ${isSelected ? "border-accent bg-accent-soft/50" : "border-border"}`}
  68:     >
  69:       <div className="mb-2 flex items-center justify-between">
  70:         <span className="text-xs font-semibold uppercase tracking-wide text-faint">
  71:           Candidato #{rank}
  72:           {isSelected ? " (selecionado)" : ""}
  73:         </span>
  74:         {noCandidate
  75:           ? pill("Sem candidato", "bg-surface-2 text-faint")
  76:           : (
  77:             <span className="flex items-center gap-1">
  78:               {pill(candidate.confidence_band, bandClasses[candidate.confidence_band])}
  79:               <span className="font-mono text-xs font-medium tabular-nums text-muted">
  80:                 {confidencePercent(candidate.confidence)}
