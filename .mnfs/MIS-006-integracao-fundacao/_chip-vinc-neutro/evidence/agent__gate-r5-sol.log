 702: func classifyProviderIdentityAnchor(anchor ports.ProviderIdentityAnchor, comparison providerIdentityAnchorComparison) (domain.LinkCandidateReasonDirection, domain.LinkCandidateReasonSide, string, bool) {
 703: 	if !anchor.Supplied {
 704: 		return domain.LinkCandidateReasonDirectionUnavailable, "", fmt.Sprintf("provider não fornece a âncora %s", anchor.Anchor), true
 705: 	}
 706: 
 707: 	// ListingSnapshot has no provider-side brand field. Do not infer an empty
 708: 	// provider value from that missing model surface (ADR-17).
 709: 	listingValue, productValue, readable := identityAnchorValues(anchor.Anchor, comparison.listing, comparison.product)
 710: 	if !readable {
 711: 		return domain.LinkCandidateReasonDirectionIncomparable, "", fmt.Sprintf("não foi possível comparar a âncora %s", anchor.Anchor), true
 712: 	}
 713: 	if comparison.product == nil {
 714: 		if listingValue == "" {
 715: 			return domain.LinkCandidateReasonDirectionIncomparable, domain.LinkCandidateReasonSideProvider, fmt.Sprintf("anúncio sem %s", anchor.Anchor), true
 716: 		}
 717: 		return "", "", "", false
 718: 	}
 719: 	if listingValue != "" && productValue != "" {
 720: 		return "", "", "", false
 721: 	}
 722: 	if listingValue == "" && productValue == "" {
 723: 		return domain.LinkCandidateReasonDirectionIncomparable, domain.LinkCandidateReasonSideBoth, fmt.Sprintf("anúncio e produto ERP sem %s", anchor.Anchor), true
 724: 	}
 725: 	if listingValue == "" {
 726: 		return domain.LinkCandidateReasonDirectionIncomparable, domain.LinkCandidateReasonSideProvider, fmt.Sprintf("anúncio sem %s", anchor.Anchor), true
 727: 	}
 728: 	return domain.LinkCandidateReasonDirectionIncomparable, domain.LinkCandidateReasonSideERP, fmt.Sprintf("produto ERP sem %s cadastrado", anchor.Anchor), true
 729: }
