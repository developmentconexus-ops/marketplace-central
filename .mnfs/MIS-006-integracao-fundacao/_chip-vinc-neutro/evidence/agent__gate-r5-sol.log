 202: /**
 203:  * The `side` text for a reason, or undefined when there is none to tell.
 204:  *
 205:  * The direction is checked FIRST: the frozen D-122 contract emits `side` only
 206:  * for INCOMPARABLE, so a stray value on any other direction is wire noise, not
 207:  * a fact to render. And an INCOMPARABLE whose `side` is absent stays silent —
 208:  * `classifyProviderIdentityAnchor` has a real path that emits INCOMPARABLE with
 209:  * no side (the `!readable` branch, generation_service.go:711, e.g. `marca`),
 210:  * and inventing a side there would fabricate the one thing D-B added (ADR-17).
 211:  */
 212: export function reasonSideLabel(reason: ProductLinkReason): string | undefined {
 213:   if (reason.direction !== "INCOMPARABLE") return undefined;
 214:   return reason.side ? incomparableSideLabels[reason.side] : undefined;
 215: }
 216: 
 217: /**
 218:  * IC-01 presentation rule: a reason chip ALWAYS shows its motivo (anchor) text.
 219:  * When a `detail` (which may carry a %) is present it is rendered joined to the
 220:  * motivo — so a bare % is never shown on its own; the motivo is always visible.
 221:  */
 222: export function reasonChipLabel(reason: ProductLinkReason): string {
 223:   const side = reasonSideLabel(reason);
 224:   const head = side ? `${reason.anchor} (${side})` : reason.anchor;
 225:   return reason.detail ? `${head}: ${reason.detail}` : head;
 226: }
