  | "REVIEW"
  | "REJECT"
  | "NO_CANDIDATE"
  | "CONFIRM";

export type ProductLinkReasonDirection = "FOR" | "AGAINST" | "UNAVAILABLE" | "INCOMPARABLE";
export type ProductLinkReasonSide = "provider" | "erp" | "both";

